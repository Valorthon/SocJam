# PostgreSQL
DATABASE_URL="postgresql://omnipost:omnipost@localhost:5433/omnipost?schema=public"

# Auth.js / NextAuth (configured with the authentication feature)
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (configured with the AI adaptation feature)
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
# Set AI_PROVIDER="groq" and AI_MODEL="llama-3.3-70b-versatile" to use Groq.
GROQ_API_KEY=""
AI_DAILY_LIMIT="20"

# Mock social platform adapters
MOCK_PLATFORMS="true"
MOCK_FAILURE_RATE="0"

# Scheduled publishing (configured in a future phase)
CRON_SECRET=""

# Local media storage (configured with uploads)
UPLOAD_DIR="./uploads"
