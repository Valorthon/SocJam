# PostgreSQL
DATABASE_URL="postgresql://socjam:socjam@localhost:5433/socjam?schema=public"

# Auth.js / NextAuth (configured with the authentication feature)
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (configured with the AI adaptation feature)
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
# Set AI_PROVIDER="groq" and AI_MODEL="llama-3.3-70b-versatile" to use Groq.
GROQ_API_KEY=""
AI_DAILY_LIMIT="20"

# Mock social platform adapters
MOCK_PLATFORMS="true"
MOCK_FAILURE_RATE="0"

# Phase 2a — Real Meta (Facebook + Instagram) OAuth + Facebook publishing.
# Generate with: openssl rand -base64 32
# Required before flipping either REAL_* flag to "true".
APP_ENCRYPTION_KEY=""
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/oauth/meta/callback"
META_GRAPH_API_VERSION="v19.0"
REAL_FACEBOOK="false"
# Set REAL_INSTAGRAM="true" AFTER REAL_FACEBOOK="true". Instagram connect uses
# the real Meta OAuth flow this phase, but Instagram *publishing* stays on the
# mock adapter until public media storage (S3 / Vercel Blob) is wired up.
REAL_INSTAGRAM="false"

# Scheduled publishing
CRON_SECRET=""
# Optional: documents the cron cadence for operators. The /api/cron/publish-due
# endpoint itself does not read this value; the cron schedule is managed by
# your hosting platform (e.g. vercel.json is configured for 30 minutes).
CRON_INTERVAL_MINUTES="30"

# LinkedIn real adapter (optional; leave blank to use mock)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/accounts/oauth/linkedin/callback"
LINKEDIN_ADAPTER="mock"
LINKEDIN_API_VERSION="202607"

# TikTok real adapter (optional; leave blank to use mock)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/accounts/oauth/tiktok/callback"
TIKTOK_ADAPTER="mock"

# Token encryption for stored OAuth tokens (generate with openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=""

# Local media storage (configured with uploads)
UPLOAD_DIR="./uploads"
